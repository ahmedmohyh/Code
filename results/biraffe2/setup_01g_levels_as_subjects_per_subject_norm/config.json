{
  "experiment_name": "setup_01g_levels_as_subjects_per_subject_norm",
  "seed": 42,
  "dataset": {
    "name": "BIRAFFE2",
    "path": "../dataset/data/BIRAFFE2/Version 2/BIRAFFE2-biosigs.zip",
    "metadata_path": "../dataset/data/BIRAFFE2/Version 2/BIRAFFE2-metadata.csv",
    "modalities": [
      "ECG"
    ],
    "score_column": [
      "GEQ-1-FLOW-2018",
      "GEQ-2-FLOW-2018",
      "GEQ-3-FLOW-2018",
      "GEQ-1-FLOW-2013",
      "GEQ-2-FLOW-2013",
      "GEQ-3-FLOW-2013"
    ],
    "treat_levels_as_subjects": true,
    "procedure_path": "../dataset/data/BIRAFFE2/Version 2/BIRAFFE2-procedure.zip",
    "raw_geq_dir": "",
    "recompute_flow_from_items": false,
    "exclude_time_distortion": false,
    "raw_geq_levels": [],
    "face_zip_path": "",
    "games_zip_path": "",
    "external_zip_path": ""
  },
  "label": {
    "method": "median_split",
    "margin": 0.0,
    "items": "full_subscale",
    "classes": [
      "low",
      "high"
    ]
  },
  "preprocessing": {
    "cleaning_package": "neurokit2",
    "z_standardise": true,
    "per_subject_normalize": false,
    "outlier_strategy": "train_only",
    "baseline_correction": "none",
    "baseline_length_s": 60,
    "baseline_from_procedure": false
  },
  "segmentation": {
    "window_length_s": 60,
    "step_s": 30
  },
  "features": {
    "ecg": {
      "time": [
        "hr_mean",
        "SDNN",
        "RMSSD",
        "pNN50"
      ],
      "frequency": [
        "VLF",
        "LF",
        "HF",
        "LF_HF",
        "TP"
      ],
      "nonlinear": [
        "sample_entropy",
        "DFA_alpha1",
        "DFA_alpha2"
      ]
    },
    "eeg": {
      "bands": [
        "theta",
        "alpha",
        "beta"
      ]
    },
    "package": "neurokit2"
  },
  "models": {
    "classical": [],
    "deep": [
      "MLP",
      "LSTM",
      "CNN1D"
    ]
  },
  "validation": {
    "strategy": "LOSO",
    "permutation": false,
    "metrics": [
      "accuracy",
      "f1_macro",
      "precision_low",
      "recall_low",
      "precision_high",
      "recall_high",
      "auc",
      "inference_ms"
    ]
  }
}